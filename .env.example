# Environment variables for Docker Compose
# Copy this file to .env and fill in your values

# Database
MONGODB_URI=mongodb://mongo:27017/recarnation
MONGO_INITDB_DATABASE=recarnation

# Backend
NODE_ENV=production
FRONTEND_URL=https://your-frontend-url.vercel.app

# JWT & Session
JWT_SECRET=your-jwt-secret-here
SESSION_SECRET=your-session-secret-here

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-backend-url.onrender.com/api/auth/google/callback

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Redis Cloud
# Format: rediss://:<password>@<redis-cloud-host>:<port>
# Get this from: Redis Cloud console > Database > Connect > ioredis
REDIS_URL=rediss://:your-redis-password@redis-xxxxx.c1.us-east-1-2.ec2.redns.redis-cloud.com:6380

# Groq AI
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.1-8b-instant

# Frontend
VITE_API_URL=http://localhost:3000
VITE_RAZORPAY_KEY_ID=your-razorpay-key-id

# Gemini AI (Primary)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
